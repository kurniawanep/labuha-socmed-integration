# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-key
SUPABASE_BUCKET=disseminator-media

# Meta & Threads IDs
FB_PAGE_ID=your-facebook-page-id
IG_USER_ID=your-instagram-user-id
THREADS_USER_ID=your-threads-user-id

# Meta & Threads Access Tokens
FB_ACCESS_TOKEN=your-facebook-access-token
IG_ACCESS_TOKEN=your-instagram-access-token
THREADS_ACCESS_TOKEN=your-threads-access-token

# WhatsApp Targets Configuration (Comma-separated lists of JIDs)
DISSEMINATION_WA_GROUPS=628xxx@g.us
DISSEMINATION_WA_CHANNELS=1203xxx@newsletter

# Threads Token Refresh Date Tracking
THREADS_TOKEN_REFRESH_DATE=2026-11-10
